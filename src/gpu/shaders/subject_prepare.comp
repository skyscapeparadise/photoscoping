#version 450

// The working image (linear Rec.2020, half float) -> linear Rec.709, planar:
// what ps::matting::prepare_frame makes as MattingFrame::linear.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D working;
layout(set = 2, binding = 0) uniform Params { uint width; uint height; };
layout(std430, set = 1, binding = 1) writeonly buffer Linear { float lin[]; };

const mat3 k2020To709 = mat3(1.6605, -0.1246, -0.0182,   // columns
                             -0.5876, 1.1329, -0.1006,
                             -0.0728, -0.0083, 1.1187);

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= width || p.y >= height) return;
    vec3 rgb = k2020To709 * texelFetch(working, ivec2(p), 0).rgb;
    uint n = width * height, i = p.y * width + p.x;
    lin[i] = rgb.r;
    lin[n + i] = rgb.g;
    lin[2u * n + i] = rgb.b;
}
